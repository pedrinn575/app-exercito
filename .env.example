# =============================================================================
# Variáveis de ambiente — Sistema de Escalas Militares
# Copie este arquivo para .env na raiz e preencha os valores.
# =============================================================================

# --- Supabase / PostgreSQL (conexão JDBC direta) ---
# Encontre em: Supabase Dashboard > Project Settings > Database > Connection string
SUPABASE_DB_URL=jdbc:postgresql://db.SEU_PROJETO.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=sua_senha_aqui

# --- JWT (mínimo 32 caracteres em produção) ---
JWT_SECRET=altere-esta-chave-secreta-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

# --- Backend ---
SERVER_PORT=8080
APP_SEED_ENABLED=true

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080/api
